# Database (dedicated container on host port 5433)
POSTGRES_USER=estimation
POSTGRES_PASSWORD=estimation
POSTGRES_DB=estimation
DATABASE_URL=postgresql://estimation:estimation@localhost:5433/estimation?schema=public

# API
API_PORT=4001
API_HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# App
APP_NAME=Project Estimation
DEFAULT_CURRENCY=USD
TARGET_MARGIN=0.5
