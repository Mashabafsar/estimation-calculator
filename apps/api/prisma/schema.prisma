generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SOLUTION_ARCHITECT
  SALES
  DELIVERY_MANAGER
  FINANCE
  READ_ONLY
}

enum EstimateStatus {
  DRAFT
  PRE_SALES_REVIEW
  MANAGEMENT_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
  WON
  LOST
}

enum Complexity {
  LOW
  MEDIUM
  HIGH
  ENTERPRISE
}

enum ResourceLocation {
  ONSHORE
  OFFSHORE
}

enum ExpenseCategory {
  HOSTING
  INFRASTRUCTURE
  AWS
  AZURE
  GCP
  THIRD_PARTY_API
  LICENSE
  SUBCONTRACTOR
  TRAVEL
  MEETING
  EQUIPMENT
  MARKETING
  LEGAL
  COMPLIANCE
  SECURITY
  DEV_SERVER
  MISCELLANEOUS
  OTHER
}

enum MarginHealth {
  GREEN
  YELLOW
  RED
}

enum ApprovalAction {
  SUBMIT
  APPROVE
  REJECT
  REQUEST_CHANGES
  ARCHIVE
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole  @default(SALES)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  salesClients      Client[]           @relation("SalesPerson")
  accountClients    Client[]           @relation("AccountManager")
  estimatesCreated  Estimate[]         @relation("EstimateCreator")
  estimateVersions  EstimateVersion[]  @relation("VersionAuthor")
  approvals         Approval[]
  auditLogs         AuditLog[]

  @@map("users")
}

model Currency {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  symbol    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients   Client[]
  estimates Estimate[]
  roles     EmployeeRole[]

  @@map("currencies")
}

model Country {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients Client[]

  @@map("countries")
}

model EmployeeRole {
  id               String   @id @default(cuid())
  name             String   @unique
  slug             String   @unique
  hourlyCostRate   Decimal  @db.Decimal(12, 2)
  hourlyBillingRate Decimal @db.Decimal(12, 2)
  currencyId       String?
  currency         Currency? @relation(fields: [currencyId], references: [id])
  defaultLocation  ResourceLocation @default(OFFSHORE)
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  templateRoles    TemplateRole[]
  estimateResources EstimateResource[]

  @@map("employee_roles")
}

model GlobalSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  label       String?
  description String?
  dataType    String   @default("number")
  category    String   @default("general")
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("global_settings")
}

model PaymentTerm {
  id             String   @id @default(cuid())
  label          String
  minAmount      Decimal  @db.Decimal(14, 2)
  maxAmount      Decimal? @db.Decimal(14, 2)
  warrantyDays   Int
  terms          String
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("payment_terms")
}

model ServiceTemplate {
  id                      String   @id @default(cuid())
  name                    String
  slug                    String   @unique
  description             String?
  commissionRate          Decimal  @db.Decimal(8, 4)
  cogsRate                Decimal  @db.Decimal(8, 4)
  defaultSubcontractor    Decimal  @default(0) @db.Decimal(14, 2)
  defaultDevServerCost    Decimal  @default(0) @db.Decimal(14, 2)
  defaultMargin           Decimal? @db.Decimal(8, 4)
  defaultRiskPct          Decimal? @db.Decimal(8, 4)
  defaultContingencyPct   Decimal? @db.Decimal(8, 4)
  defaultQaPct            Decimal? @db.Decimal(8, 4)
  defaultPmPct            Decimal? @db.Decimal(8, 4)
  defaultInfrastructurePct Decimal? @db.Decimal(8, 4)
  defaultSprintCount      Int      @default(10)
  defaultSprintWeeks      Int      @default(2)
  /// [{ name, percentage }] — payment/effort milestones (0–1). Null = engine default plan.
  sprintPaymentPlan       Json?
  isActive                Boolean  @default(true)
  sortOrder               Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  roles     TemplateRole[]
  estimates Estimate[]

  @@map("service_templates")
}

model TemplateRole {
  id         String          @id @default(cuid())
  templateId String
  roleId     String
  location   ResourceLocation @default(OFFSHORE)
  defaultHours Decimal       @default(0) @db.Decimal(12, 2)
  billRateOverride Decimal?  @db.Decimal(12, 2)
  costRateOverride Decimal?  @db.Decimal(12, 2)
  sortOrder  Int             @default(0)

  template ServiceTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  role     EmployeeRole    @relation(fields: [roleId], references: [id])

  @@unique([templateId, roleId, location])
  @@map("template_roles")
}

model Client {
  id                String   @id @default(cuid())
  name              String
  industry          String?
  countryId         String?
  currencyId        String?
  salesPersonId     String?
  accountManagerId  String?
  notes             String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  country        Country?  @relation(fields: [countryId], references: [id])
  currency       Currency? @relation(fields: [currencyId], references: [id])
  salesPerson    User?     @relation("SalesPerson", fields: [salesPersonId], references: [id])
  accountManager User?     @relation("AccountManager", fields: [accountManagerId], references: [id])
  estimates      Estimate[]

  @@map("clients")
}

model Estimate {
  id               String         @id @default(cuid())
  estimateNumber   String         @unique
  projectName      String
  description      String?
  clientId         String?
  templateId       String?
  complexity       Complexity     @default(MEDIUM)
  status           EstimateStatus @default(DRAFT)
  startDate        DateTime?
  expectedDelivery DateTime?
  currencyId       String?
  negotiatedPrice  Decimal?       @db.Decimal(14, 2)
  recommendedPrice Decimal?       @db.Decimal(14, 2)
  discountPct      Decimal?       @db.Decimal(8, 4)
  sprintCount      Int?
  sprintWeeks      Int?
  /// Override template sprint plan for this estimate [{ name, percentage }]
  sprintPaymentPlan Json?
  currentVersion   Int            @default(1)
  createdById      String
  wonAt            DateTime?
  lostAt           DateTime?
  archivedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  client      Client?          @relation(fields: [clientId], references: [id])
  template    ServiceTemplate? @relation(fields: [templateId], references: [id])
  currency    Currency?        @relation(fields: [currencyId], references: [id])
  createdBy   User             @relation("EstimateCreator", fields: [createdById], references: [id])
  resources   EstimateResource[]
  expenses    EstimateExpense[]
  calculation EstimateCalculation?
  scenarios   EstimateScenario[]
  versions    EstimateVersion[]
  approvals   Approval[]

  @@index([status])
  @@index([clientId])
  @@index([createdById])
  @@map("estimates")
}

model EstimateResource {
  id            String           @id @default(cuid())
  estimateId    String
  roleId        String?
  roleName      String
  location      ResourceLocation @default(OFFSHORE)
  hours         Decimal          @db.Decimal(12, 2)
  hourlyCost    Decimal          @db.Decimal(12, 2)
  hourlyBilling Decimal          @db.Decimal(12, 2)
  totalCost     Decimal          @db.Decimal(14, 2)
  totalRevenue  Decimal          @db.Decimal(14, 2)
  sortOrder     Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  estimate Estimate      @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  role     EmployeeRole? @relation(fields: [roleId], references: [id])

  @@map("estimate_resources")
}

model EstimateExpense {
  id          String          @id @default(cuid())
  estimateId  String
  category    ExpenseCategory @default(OTHER)
  name        String
  amount      Decimal         @db.Decimal(14, 2)
  isRecurring Boolean         @default(false)
  notes       String?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@map("estimate_expenses")
}

/// Snapshot of backend calculation results — frontend displays only
model EstimateCalculation {
  id                      String      @id @default(cuid())
  estimateId              String      @unique
  totalHours              Decimal     @db.Decimal(14, 2)
  labourCost              Decimal     @db.Decimal(14, 2)
  labourRevenue           Decimal     @db.Decimal(14, 2)
  salesCommission         Decimal     @db.Decimal(14, 2)
  cogs                    Decimal     @db.Decimal(14, 2)
  expenseTotal            Decimal     @db.Decimal(14, 2)
  directCosts             Decimal     @db.Decimal(14, 2)
  developmentCost         Decimal     @db.Decimal(14, 2)
  operatingCost           Decimal     @db.Decimal(14, 2)
  engagementFee           Decimal     @db.Decimal(14, 2)
  recommendedPrice        Decimal     @db.Decimal(14, 2)
  clientPrice             Decimal     @db.Decimal(14, 2)
  grossProfit             Decimal     @db.Decimal(14, 2)
  netProfit               Decimal     @db.Decimal(14, 2)
  directMargin            Decimal     @db.Decimal(14, 2)
  grossMarginPct          Decimal     @db.Decimal(8, 4)
  netMarginPct            Decimal     @db.Decimal(8, 4)
  targetMarginAmount      Decimal     @db.Decimal(14, 2)
  targetMarginPct         Decimal     @db.Decimal(8, 4)
  excessDeficit           Decimal     @db.Decimal(14, 2)
  markupPct               Decimal     @db.Decimal(8, 4)
  discountPct             Decimal     @db.Decimal(8, 4)
  breakEven               Decimal     @db.Decimal(14, 2)
  weightedHourlyCost      Decimal     @db.Decimal(12, 4)
  weightedHourlyBilling   Decimal     @db.Decimal(12, 4)
  averageTeamCost         Decimal     @db.Decimal(12, 4)
  averageTeamBilling      Decimal     @db.Decimal(12, 4)
  apiRate                 Decimal     @db.Decimal(12, 4)
  marketRate              Decimal     @db.Decimal(12, 4)
  riskBuffer              Decimal     @db.Decimal(14, 2)
  contingencyBuffer       Decimal     @db.Decimal(14, 2)
  infrastructureCost      Decimal     @db.Decimal(14, 2)
  supportCost             Decimal     @db.Decimal(14, 2)
  warrantyCost            Decimal     @db.Decimal(14, 2)
  maintenanceCost         Decimal     @db.Decimal(14, 2)
  recurringCost           Decimal     @db.Decimal(14, 2)
  monthlyCost             Decimal     @db.Decimal(14, 2)
  annualCost              Decimal     @db.Decimal(14, 2)
  roi                     Decimal     @db.Decimal(10, 4)
  marginHealth            MarginHealth @default(YELLOW)
  paymentTermLabel        String?
  paymentTerms            String?
  warrantyDays            Int?
  recommendations         Json?
  cashFlowProjection      Json?
  rawBreakdown            Json?
  departmentTotals        Json?
  sprintBreakdown         Json?
  calculatedAt            DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@map("estimate_calculations")
}

model EstimateScenario {
  id               String   @id @default(cuid())
  estimateId       String
  name             String
  isWinner         Boolean  @default(false)
  negotiatedPrice  Decimal? @db.Decimal(14, 2)
  timelineDays     Int?
  resourceSnapshot Json?
  expenseSnapshot  Json?
  resultSnapshot   Json?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@map("estimate_scenarios")
}

model EstimateVersion {
  id          String   @id @default(cuid())
  estimateId  String
  version     Int
  snapshot    Json
  changeSummary String?
  createdById String
  createdAt   DateTime @default(now())

  estimate  Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  createdBy User     @relation("VersionAuthor", fields: [createdById], references: [id])

  @@unique([estimateId, version])
  @@map("estimate_versions")
}

model Approval {
  id         String         @id @default(cuid())
  estimateId String
  action     ApprovalAction
  fromStatus EstimateStatus?
  toStatus   EstimateStatus?
  comment    String?
  actorId    String
  createdAt  DateTime       @default(now())

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  actor    User     @relation(fields: [actorId], references: [id])

  @@map("approvals")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Extensibility hooks for future AI features (no runtime AI yet)
model AiSuggestion {
  id         String   @id @default(cuid())
  estimateId String?
  type       String
  input      Json?
  output     Json?
  confidence Decimal? @db.Decimal(5, 4)
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([estimateId])
  @@map("ai_suggestions")
}
